{
  "server": {
    "port": 6600
  },
  "polling": {
    "github": 60,
    "codemagic": 120,
    "lark": 120,
    "stores": 600
  },
  "github": {
    "account": "your-github-login",
    "repos": [
      "your-org/repo-a",
      "your-org/repo-b"
    ]
  },
  "codemagic": {
    "enabled": true
  },
  "lark": {
    "domain": "example.larksuite.com",
    "baseToken": "bascXXXX",
    "tables": {
      "tasks": {
        "tableId": "tblXXXX",
        "viewId": "vewXXXX",
        "createFormUrl": "https://yourcompany.larksuite.com/share/base/form/shrXXXX",
        "pendingLaunchStatus": "PENDING TO LAUNCH",
        "collapsedStatuses": [
          "PRODUCTION"
        ],
        "fields": {
          "title": "Task Name",
          "status": "Status",
          "pic": "PIC",
          "type": "Task Type",
          "priority": "Priority",
          "progress": "Progress"
        },
        "groupOrder": [
          "PENDING TO LAUNCH",
          "SENIOR QC",
          "IN PROGRESS"
        ]
      },
      "issues": {
        "tableId": "tblXXXX",
        "viewId": "vewXXXX",
        "showStatuses": [
          "OPEN",
          "CHECKING"
        ],
        "fields": {
          "ticketId": "Ticket ID",
          "reportedDate": "Reported Date",
          "hoursSince": "Hours Since",
          "priority": "Priority",
          "store": "ERP Store Name / Email",
          "description": "Issue Description",
          "status": "Status",
          "reportedBy": "Reported By",
          "taggedPic": "Tagged PIC",
          "modulePic": "Module PIC",
          "attachments": "Attachment"
        }
      },
      "feedback": {
        "tableId": "tblXXXX",
        "viewId": "vewXXXX",
        "limit": 30,
        "fields": {
          "reportedDate": "Reported Date",
          "category": "Category",
          "store": "ERP Store Name / Email",
          "text": "Feedback / Suggestion",
          "rid": "RID",
          "status": "R&D Status",
          "pic": "PIC",
          "reportedBy": "Reported By",
          "taskLink": "R&D Task Link",
          "attachments": "Attachment"
        },
        "groupOrder": [
          "NEW"
        ]
      }
    }
  },
  "stores": {
    "accounts": []
  }
}
