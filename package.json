{
  "name": "nexpulse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun concurrently -k -n server,web -c blue,magenta \"bun --watch server/index.ts\" \"bun --bun vite --config web/vite.config.ts\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "bun --bun vite --config web/vite.config.ts",
    "build": "bun --bun vite build --config web/vite.config.ts",
    "start": "bun server/index.ts",
    "check": "bun server/check.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 install",
    "startup:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 status",
    "startup:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 restart",
    "startup:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 stop",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 uninstall",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/ibm-plex-sans": "^5",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20",
    "@testing-library/react": "^16",
    "@types/bun": "^1.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10",
    "typescript": "^5",
    "vite": "^8"
  }
}
